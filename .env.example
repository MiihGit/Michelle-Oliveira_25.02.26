# Copie este arquivo para ".env" (nunca commitado, já está no .gitignore)
# e preencha com suas credenciais reais.

# E-mail do Gmail usado para enviar os códigos de verificação
EMAIL_USER=seu-email@gmail.com

# Senha de App gerada em https://myaccount.google.com/apppasswords
# (NÃO é a senha normal da conta Google)
EMAIL_PASS=
